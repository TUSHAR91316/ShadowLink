{
    "compilerOptions": {
        "composite": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@renderer/*": [
                "src/renderer/src/*"
            ]
        }
    },
    "include": [
        "src/renderer/**/*"
    ]
}