{
  "name": "electron",
  "version": "1.0.0",
  "description": "",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=out/main/index.js --external:electron --external:@electron-toolkit/utils",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --outfile=out/preload/index.js --external:electron",
    "build:css": "tailwindcss -i src/renderer/src/input.css -o src/renderer/src/out.css --config tailwind.config.cjs",
    "build:renderer": "npm run build:css && vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.shadowlink.vpn",
    "productName": "ShadowLink",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/api.exe",
        "to": "api.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.27.3",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  }
}
